# Copy to .env.local and fill in real values. Never commit real secrets.

# ─── Brand (lib/brand.ts) ───────────────────────────────────────────────────
# Inlined at build time: changing these needs a rebuild/redeploy.
# Leave unset to keep the CartRenew defaults shown below.
NEXT_PUBLIC_APP_NAME=CartRenew
NEXT_PUBLIC_APP_TAGLINE=WhatsApp Cart Recovery
NEXT_PUBLIC_SUPPORT_EMAIL=contact@cartrenew.com
# Public site URL shown in legal pages. Also the fallback for SHOPIFY_APP_URL
# when that is unset, so set SHOPIFY_APP_URL explicitly for each Shopify app.
NEXT_PUBLIC_APP_URL=https://www.cartrenew.com

# ─── Shopify app ────────────────────────────────────────────────────────────
# Base URL of this deployment (billing return URL, OAuth redirects). No trailing slash.
SHOPIFY_APP_URL=https://www.cartrenew.com

# ─── Pingza recovery email (Resend) ─────────────────────────────────────────
# Leave these empty. Email sends only when EMAIL_RECOVERY_ENABLED=true and
# EMAIL_RECOVERY_ALLOWLIST is set ("*" allows every consented address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_POSTAL_ADDRESS=
EMAIL_RECOVERY_ENABLED=
EMAIL_RECOVERY_ALLOWLIST=
EMAIL_UNSUBSCRIBE_SECRET=
# HMAC key for erased email_suppressions rows. Not the unsubscribe secret.
SUPPRESSION_HASH_SECRET=
